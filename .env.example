NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Keep disabled for Supabase Auth. Production local sign-in requires all values below
# to be configured as private hosting environment variables (never in source control).
LOCAL_AUTH_ENABLED=false
# LOCAL_AUTH_EMAIL=
# LOCAL_AUTH_PASSWORD=  (unique, at least 16 characters)
# LOCAL_AUTH_SECRET=    (random, at least 32 characters)
# LOCAL_AUTH_SCHOOL_ID= (UUID of an existing school workspace)
# LOCAL_AUTH_ROLE=school_admin
# Absolute site origin used in password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local only. On Vercel, @sparticuz/chromium is used when this is unset.
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
